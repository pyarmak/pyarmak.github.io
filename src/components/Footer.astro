---
import { legalLinks, navigationLinks, siteName, withBase } from '../utils/site'
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <h3>{siteName}</h3>
      <p class="muted">
        Comprehensive ophthalmologist practicing in Winnipeg, Manitoba.
      </p>
    </div>
    <!-- <div>
      <h4>Quick Links</h4>
      <ul class="footer-links">
        {navigationLinks.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </div> -->
    <div>
      <h4>Contact</h4>
      <address class="footer-contact">
        <span>
          Phone: <a href="tel:+12049424479">(204) 942-4479</a>
        </span>
        <span>Address: 444 St Mary Ave #235, Winnipeg, MB</span>
        <span>Office hours: Monday-Friday, 8:30 AM-5:00 PM</span>
      </address>
      <ul class="footer-links footer-legal">
        {legalLinks.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container copyright">© {new Date().getFullYear()} {siteName}.</div>
</footer>
