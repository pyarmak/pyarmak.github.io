---
import { Image } from 'astro:assets';
import profileImage from '../images/profile.jpg';

const {
  eyebrow,
  title,
  copy,
  ctaText = 'Request Appointment',
  ctaHref = '/contact',
  secondaryCtaText,
  secondaryCtaHref,
  highlights = [],
  mediaDetails = [],
} = Astro.props
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
      <div class="hero-intro">
          <p class="muted">
            Comprehensive Ophthalmologist
          </p>
        <p class="lead">I was born in Ukraine, from there, I moved to Israel and finally to Winnipeg. I speak English and Russian fluently but I'm out of practice with my Hebrew.</p>
        <p class="lead">I completed my undergraduate studies at the University of Toronto with a major in psychology and neuroscience. I then returned to Winnipeg for my medical school and ophthalmology residency training at the University of Manitoba.</p>
        <p class="lead">I am passionate about technology and its application in modern ophthalmology and have recieved awards for my research on diabetic retinopathy screening using artificial intelligence.</p>
      </div>
      {highlights.length ? (
        <ul class="hero-highlights" aria-label="Practice highlights">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ) : null}
      <!-- <div class="hero-ctas">
        <a class="btn primary large" href={ctaHref}>{ctaText}</a>
        {secondaryCtaText && secondaryCtaHref ? (
          <a class="btn secondary large" href={secondaryCtaHref}>{secondaryCtaText}</a>
        ) : null}
      </div> -->
    </div>
    <aside class="hero-media" aria-label="Image of Dr. Pavel Yarmak, MD, FRCSC">
      <div class="hero-visual">
        <Image
          src={profileImage}
          alt="Dr. Pavel Yarmak, MD, FRCSC"
          class="hero-image"
          layout="constrained"
          inferSize
          priority
        />
      </div>
    </aside>
  </div>
</section>
